{
  "name": "@floralink/generator",
  "version": "2.0.0",
  "description": "A simple CLI for generating a JSON database from a CSV file and options defined in elements of the `groups` key in a Floralink plugin",
  "author": {
    "name": "Vincent Ruge",
    "email": "info@schwince.de"
  },
  "license": "AGPL-3.0-or-later",
  "bin": {
    "flgen": "dist/bin.js"
  },
  "scripts": {
    "clean": "biome check --write",
    "deps": "npm-check-updates --interactive --format group",
    "build": "rimraf dist && tsc --declaration"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.14",
    "@types/node": "^25.6.0",
    "npm-check-updates": "^22.1.0",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@floralink/core": "^2.0.1",
    "citty": "^0.2.2",
    "consola": "^3.4.2"
  }
}
